{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "mousa": {
      "type": "stdio",
      "command": "node",
      "args": [
        "${PLUGIN_ROOT}/server/mousa.mjs"
      ],
      "env": {
        "MOUSA_HOST": "kiro",
        "MOUSA_PROJECT_DIR": "${MOUSA_PROJECT_DIR}",
        "QLOO_API_KEY": "${QLOO_API_KEY}",
        "QLOO_BASE_URL": "${QLOO_BASE_URL}",
        "MOUSA_QLOO_BUDGET": "${MOUSA_QLOO_BUDGET}"
      }
    }
  }
}
