{
  "mcpServers": {
    "mousa": {
      "command": "node",
      "args": [
        "./server/mousa.mjs"
      ],
      "cwd": ".",
      "env": {
        "MOUSA_HOST": "codex"
      },
      "env_vars": [
        "QLOO_API_KEY",
        "QLOO_BASE_URL",
        "MOUSA_QLOO_BUDGET",
        "MOUSA_IMAGES_PER_RUN",
        "MOUSA_BROWSER",
        "MOUSA_CAPTURE",
        "MOUSA_CAPTURE_NO_SANDBOX",
        "CODEX_IMAGES",
        "CODEX_CLI_PATH"
      ],
      "startup_timeout_sec": 20,
      "tool_timeout_sec": 600,
      "tools": {
        "mousa_open_project": {
          "approval_mode": "prompt"
        }
      }
    }
  }
}
