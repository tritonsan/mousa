# Put credentials here locally; this file is never served to the browser.
# Do not commit .env. On AWS use a secret store or protected environment file.
HOST=127.0.0.1
PORT=8787
PREVIEW_PORT=8788
# On AWS point to the separate preview hostname, e.g. https://preview.your-domain.
PUBLIC_PREVIEW_BASE_URL=
DATA_DIR=./data
# Required if HOST is not loopback. Use a long random value for jury access.
DEMO_ACCESS_TOKEN=
# Optional locally: the existing Kiro login can be used. Required on a server.
KIRO_API_KEY=
# Leave the CLI path empty to discover the installed CLI.
KIRO_CLI_PATH=
# Model selected for this demo; choose another ID if your account requires it.
KIRO_MODEL=claude-opus-5.5
KIRO_EFFORT=medium
# One Kiro run's limit, not counting host waits such as image generation and captures. 15 minutes leaves room for
# the production stages' reading, plan and self-review; without the stages the default is 10 minutes.
KIRO_RUN_TIMEOUT_MS=900000
# Stored jobs the Studio keeps, finished ones included (1-200). Raise it for repeated local comparisons.
MAX_JOBS=30
# taste: host Qloo taste pass, blind prediction and binding Design DNA (default).
# research: the 0.3.0 plan/research/reconsideration workflow with web tools.
CREATIVE_PROTOCOL=taste
# Qloo-enabled jobs require the real hackathon key. No simulated fallback.
QLOO_API_KEY=
QLOO_API_BASE_URL=https://hackathon.api.qloo.com
# Generated images for taste-led builds: auto uses Codex when its CLI (0.160.0 or later) is signed in with ChatGPT,
# so images draw on the ChatGPT plan rather than an API key. off removes the image tool from both arms.
CODEX_IMAGES=auto
# Leave empty to discover the CLI the Codex app bundles; set it to use another codex executable.
CODEX_CLI_PATH=
# Production stages for taste-led site builds: each designer reads its taste input, plans how every DNA device is
# made from the methods this server offers, and reviews captures of its saved site. off keeps the taste-led protocol alone.
PRODUCTION_STAGES=on
# hosted: a server without Codex. No image generator is offered, so plans make imagery without one and a study cannot
# require generated images.
MOUSA_ENVIRONMENT=local
# Captures for the self-review: auto uses an installed Edge, Chrome or Chromium (MOUSA_BROWSER names another
# executable) once it has captured a test page at start; off turns them off. Where the browser's sandbox cannot start
# (as root, or in a container that blocks user namespaces), MOUSA_CAPTURE_NO_SANDBOX=1 runs it without its sandbox;
# read docs/aws-deployment.md before setting it on a server.
MOUSA_CAPTURE=auto
MOUSA_BROWSER=
