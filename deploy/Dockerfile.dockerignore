# This Dockerfile uses the repository root as its build context.
# Keep only runtime source, the game and libraries it serves, and its deployment entrypoint.
**
!package.json
!src/
!src/**
!web/
!web/**
!plugin/
!plugin/**
!game/
!game/**
# Recorded runs hold design sessions and Kiro homes; tests are not runtime code.
game/runs
game/runs/**
game/tests
game/tests/**
!library/
!library/**
# The live try's starters, without their agent folders or design records.
!examples/
!examples/mobile-app/
!examples/mobile-app/**
!examples/long-dusk/
!examples/long-dusk/**
**/.kiro
**/.mousa
!deploy/
!deploy/Dockerfile
!deploy/Dockerfile.dockerignore
!deploy/entrypoint.sh
**/.env
**/.env.*
**/node_modules
**/.git
**/data
# Ramble's walks are its product facts, and the try protects them; they come after the rule above, which they override.
!examples/mobile-app/data
!examples/mobile-app/data/**
**/secrets
**/*.pem
**/*.key
**/*credentials*
