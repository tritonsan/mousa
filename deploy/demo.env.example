# Copy outside the repository, restrict file permissions, and fill locally.
# This template contains no account credentials. Never commit the filled file.
DEMO_ACCESS_TOKEN=
KIRO_API_KEY=
QLOO_API_KEY=
KIRO_MODEL=claude-opus-5.5
KIRO_EFFORT=medium
QLOO_API_BASE_URL=https://hackathon.api.qloo.com
# 15 minutes per run leaves room for the production stages' reading, plan and self-review.
KIRO_RUN_TIMEOUT_MS=900000
# Recorded jobs copied into the volume count toward the job limit.
MAX_JOBS=30
PRODUCTION_STAGES=on
MOUSA_CAPTURE=auto
# Leave empty unless you accept running Chromium without its own sandbox; read docs/aws-deployment.md first.
MOUSA_CAPTURE_NO_SANDBOX=
DEMO_PORT=8787
DEMO_PREVIEW_PORT=8788
PUBLIC_PREVIEW_BASE_URL=http://127.0.0.1:8788
KIRO_RELEASE_CHANNEL=stable
# Optional build-time version drift guard; not a version selection parameter.
KIRO_EXPECTED_VERSION=
