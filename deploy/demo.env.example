# Copy outside the repository, restrict file permissions, and fill locally.
# This template contains no account credentials. Never commit the filled file.
DEMO_ACCESS_TOKEN=
KIRO_API_KEY=
QLOO_API_KEY=
KIRO_MODEL=claude-opus-5.5
KIRO_EFFORT=medium
QLOO_API_BASE_URL=https://hackathon.api.qloo.com
# 15 minutes per run leaves room for the production stages' reading, plan and self-review.
KIRO_RUN_TIMEOUT_MS=900000
# Recorded jobs copied into the volume count toward the job limit.
MAX_JOBS=30
PRODUCTION_STAGES=on
MOUSA_CAPTURE=auto
# Leave empty unless you accept running Chromium without its own sandbox; read docs/aws-deployment.md first.
MOUSA_CAPTURE_NO_SANDBOX=
DEMO_PORT=8787
DEMO_PREVIEW_PORT=8788
# 127.0.0.1 for Caddy on the host; 0.0.0.0 behind CloudFront, with the security group admitting only CloudFront.
DEMO_BIND=127.0.0.1
PUBLIC_PREVIEW_BASE_URL=http://127.0.0.1:8788
# Behind CloudFront: the two distributions' addresses, e.g. https://d111111abcdef8.cloudfront.net and https://d222222abcdef8.cloudfront.net.
PUBLIC_APP_BASE_URL=
# Proxies in front that append to X-Forwarded-For: 1 for CloudFront or Caddy alone, 2 for CloudFront in front of Caddy.
TRUST_PROXY=1
KIRO_RELEASE_CHANNEL=stable
# Optional build-time version drift guard; not a version selection parameter.
KIRO_EXPECTED_VERSION=
# The build stops on another Kiro major version than this one (CLI 3.0 is due by the end of October 2026); empty accepts any.
KIRO_EXPECTED_MAJOR=2
# The commit the image is built from: MOUSA_COMMIT=$(git rev-parse --short HEAD) docker compose build
MOUSA_COMMIT=
# Signs the blind vote's ballots and the try's access: a long random value (openssl rand -hex 32).
SITE_SECRET=
# The public repository the site links to, once there is one (https only).
SITE_REPOSITORY_URL=
# The jury's code for the live try, 12 characters or more; empty keeps the try closed. TRY_ACCESS=open asks for no
# code at all, as the jury's server does, since the hackathon gives jurors no field for one.
TRY_ACCESS_CODE=
TRY_ACCESS=code
TRY_ARMS_PARALLEL=on
TRY_QLOO_BUDGET=24
# Optional caps on the server's own day for the try: first steps, pairs and Kiro credits, all off at 0. An open try
# needs them; the jury's server allows 100 first steps and 10 pairs a day. Each try's record keeps what its sessions
# cost (live pairs have cost 47 to 87 credits).
TRY_DAILY_RUNS=0
TRY_DAILY_PAIRS=0
TRY_DAILY_CREDITS=0
# A finished try older than this keeps its record, reports and designs; its Kiro homes and session streams go.
TRY_PRIVATE_RETENTION_DAYS=14
# The longer side of a review capture handed to the model; empty is 1024 pixels on a hosted server.
MOUSA_CAPTURE_INLINE_SIDE=
# One JSON object a line for the log collector, with each request's route pattern (never an id or a token).
LOG_FORMAT=json
REQUEST_LOG=on
# off: the Studio's own paid job runs take no new work; their records stay readable, and /mcp and the job bridge are closed.
LEGACY_JOBS=off
