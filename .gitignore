node_modules/
.env
.env.*
!.env.example
# The Studio's own DATA_DIR at the root: jobs, tries, votes and the built gallery, never published. A starter's data
# folder, such as examples/mobile-app/data, is its product facts and is tracked.
/data/
artifacts/
output/
*.log
*.zip
coverage/
.playwright-mcp/

# Kiro CLI writes a lock beside its settings while it runs; the lock is this machine's, never the repository's.
.kiro/settings/cli.json.lock
# Kiro homes the game's command-line runs keep beside their records: session transcripts, never published.
game/runs/**/kiro-home/
# A live run's records hold Qloo's answers, which Qloo's developer guide keeps out of a public repository. New runs
# stay on this machine; the two recorded runs kept here carry stand-in ids and no scores, and the replay fixtures stay.
game/runs/*/
!game/runs/dry-run/
examples/*-run-*/
# The desktop app's launch settings and the brand logo's source file are this machine's own; the served copy is
# web/assets/mousa-logo.png.
.claude/launch.json
/Moûsa Layered Gradient Logo.png
